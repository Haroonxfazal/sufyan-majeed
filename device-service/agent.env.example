# Copy this file to agent.env and put it next to UniqueAcademyAgent.exe

# Supabase (same values as the website)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ZKTeco MB460 fingerprint machine (academy network)
ZKTECO_IP=192.168.100.30
ZKTECO_PORT=4370
ZKTECO_PASSWORD=0
ZKTECO_TIMEOUT=5
ZKTECO_DEVICE_SERIAL=AF6P210960179

# Android SMS gateway phone (academy network)
SMS_GATEWAY_URL=http://192.168.100.20:8080
SMS_GATEWAY_AUTH_TOKEN=
SMS_GATEWAY_DEVICE_ID=
# false = SMS are only logged, not really sent
SMS_GATEWAY_ENABLED=true

# How often to check the machine and the SMS queue (seconds)
AGENT_INTERVAL_SECONDS=2
# When the program starts, re-send punches from this many past days (safe: duplicates are ignored)
AGENT_CATCHUP_DAYS=2
