# Copy this file to agent.env and put it next to UniqueAcademyAgent.exe

# Supabase (same values as the website)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ZKTeco MB460 fingerprint machine (academy network)
ZKTECO_IP=192.168.100.30
ZKTECO_PORT=4370
ZKTECO_PASSWORD=0
ZKTECO_TIMEOUT=5
ZKTECO_DEVICE_SERIAL=AF6P210960179


# How often to check the machine (seconds)
AGENT_INTERVAL_SECONDS=2
# When the program starts, re-send punches from this many past days (safe: duplicates are ignored)
AGENT_CATCHUP_DAYS=2
